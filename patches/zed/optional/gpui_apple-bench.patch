@@ -0,0 +1,27 @@
+//! OptChat bench instrumentation. Counters are read by the bench app; the knobs default to upstream behaviour.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+/// nanoseconds the main thread waited inside `CAMetalLayer.nextDrawable`
+pub static DRAWABLE_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+/// nanoseconds spent encoding + committing a frame (render_frame + present/commit)
+pub static RENDER_NS: AtomicU64 = AtomicU64::new(0);
+/// frames drawn
+pub static FRAMES: AtomicU64 = AtomicU64::new(0);
+/// bytes of instance buffers ever allocated, and their current pool size setting
+pub static INSTANCE_ALLOC_BYTES: AtomicU64 = AtomicU64::new(0);
+pub static INSTANCE_BUFFER_SIZE: AtomicU64 = AtomicU64::new(0);
+/// bytes of path intermediate textures currently allocated (color + MSAA when not memoryless)
+pub static PATH_TEXTURE_BYTES: AtomicU64 = AtomicU64::new(0);
+
+pub fn snapshot() -> [u64; 6] {
+    [DRAWABLE_WAIT_NS.load(Relaxed), RENDER_NS.load(Relaxed), FRAMES.load(Relaxed), INSTANCE_ALLOC_BYTES.load(Relaxed), INSTANCE_BUFFER_SIZE.load(Relaxed), PATH_TEXTURE_BYTES.load(Relaxed)]
+}
+
+/// GPUI_MAX_DRAWABLES (2 or 3; upstream 3)
+pub fn max_drawables() -> u64 {
+    std::env::var("GPUI_MAX_DRAWABLES").ok().and_then(|v| v.parse().ok()).filter(|n| *n == 2 || *n == 3).unwrap_or(3)
+}
+/// GPUI_LAZY_PATH_TEXTURE=1: allocate the full-window path texture only when a frame has paths (upstream: always)
+pub fn lazy_path_texture() -> bool {
+    std::env::var("GPUI_LAZY_PATH_TEXTURE").map(|v| v == "1").unwrap_or(false)
+}
