#!/usr/bin/env bash
# Run a local OptChat engine (reframe hypervisor, REFRAME_LOCAL=1) on Linux and open it at
# https://chat.reframe.dev/ in your normal Chrome, or in the native OptChat app.
#
#   optchat-local [web]       start hypervisor + caddy, open https://chat.reframe.dev/ in Chrome
#   optchat-local app         start hypervisor + caddy, open the native OptChat app
#   optchat-local serve       start hypervisor + caddy only (Ctrl-C stops both)
#   optchat-local stop        stop anything still listening on :8000 / :8080 / :8443 / :443
#   optchat-local status      show what runs and whether https://chat.reframe.dev/ works
#   optchat-local logs        follow the hypervisor and caddy logs
#   optchat-local config      write and check the Caddyfile it would use
#   optchat-local setup       one-time, no sudo: local CA + chat.reframe.dev cert, trusted by Chrome
#   sudo optchat-local root   one-time, root: /etc/hosts entry, caddy may bind :443, CA in the system store
#
# Closing the app (or Ctrl-C here) stops the hypervisor and caddy too.
set -euo pipefail

# Under sudo, act on the invoking user's files, not root's.
if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]]; then
  USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
else
  USER_HOME=$HOME
fi

R="${REFRAME_HOME:-$USER_HOME/.reframe}"
SRC="${REFRAME_HYPERVISOR_SRC:-$R/hypervisor-src}"   # a checkout (or worktree) of the reframe repo
RUNTIME="${REFRAME_RUNTIME:-$R/runtime/reframe}"     # the patched reframe runtime (stock deno won't do)
L="$R/local"
CADDY="${OPTCHAT_CADDY:-$L/bin/caddy}"
CADDYFILE="$L/Caddyfile.optchat-local"
TLS="$L/tls"
LOGS="$L/logs"
APP="${OPTCHAT_APP:-/usr/bin/optchat}"
HOST="${OPTCHAT_HOST:-chat.reframe.dev}"
ROUTE="${OPTCHAT_ROUTE:-dj--test--optchat--default}"   # app dj/test, branch optchat
ENGINE="http://127.0.0.1:8080"
CA_NAME="OptChat Local CA ($(basename "$USER_HOME"))"

# The engine runs Codex through `codex app-server`. The snap codex (/snap/bin) is too old and exits at once,
# which leaves every chat stuck at "0 steps". Put the ChatGPT-bundled codex first.
ENGINE_PATH="/usr/lib/chatgpt/resources:$(dirname "$RUNTIME"):$USER_HOME/.local/bin:$USER_HOME/.deno/bin:$PATH"

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

port_pids() { ss -ltnpH "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u; }

# Listeners on our ports, plus any hypervisor that already closed its port but still holds the chat's
# writer.lock (that blocks a new engine with "another OptChat process ... is writing this chat").
engine_pids() {
  { for p in 8000 8080 8443 443; do port_pids "$p"; done
    pgrep -f "$SRC/hub/@reframe/cli/main.ts hypervisor" || true; } | sort -u
}

can_bind_443() {
  [[ $(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || echo 1024) -le 443 ]] && return 0
  command -v getcap >/dev/null && getcap "$CADDY" 2>/dev/null | grep -q cap_net_bind_service
}

hosts_ok() { getent ahostsv4 "$HOST" 2>/dev/null | awk '{print $1}' | grep -qx 127.0.0.1; }

certutil_bin() {
  if command -v certutil >/dev/null; then command -v certutil; return; fi
  local c="$L/tools/nss/usr/bin/certutil"
  if [[ ! -x $c ]]; then
    # libnss3-tools isn't installed: unpack it for this user only (no sudo).
    local d; d=$(mktemp -d)
    (cd "$d" && apt-get download libnss3-tools >/dev/null 2>&1) \
      || { echo "need certutil: sudo apt install libnss3-tools (or dnf install nss-tools)" >&2; rm -rf "$d"; return 1; }
    mkdir -p "$L/tools/nss" && dpkg -x "$d"/libnss3-tools_*.deb "$L/tools/nss"
    rm -rf "$d"
  fi
  echo "$c"
}

setup() {
  [[ $EUID -ne 0 ]] || { echo "run setup as yourself, not root" >&2; exit 1; }
  ( umask 077; mkdir -p "$TLS" "$LOGS" )
  local crt="$TLS/$HOST.crt" key="$TLS/$HOST.key"
  if [[ ! -f "$TLS/ca.crt" || ! -f "$TLS/ca.key" ]]; then
    ( umask 077
      openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -subj "/CN=$CA_NAME" \
        -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' -addext 'keyUsage=critical,keyCertSign,cRLSign' \
        -keyout "$TLS/ca.key" -out "$TLS/ca.crt" 2>/dev/null )
  fi
  if ! openssl verify -CAfile "$TLS/ca.crt" "$crt" >/dev/null 2>&1 \
     || ! openssl x509 -in "$crt" -noout -checkend $((30 * 86400)) >/dev/null; then
    # Keep an existing key: a Chrome profile pinned to its SPKI keeps working.
    [[ -f $key ]] || ( umask 077; openssl genrsa -out "$key" 2048 2>/dev/null )
    local ext; ext=$(mktemp)
    printf '%s\n' 'basicConstraints=critical,CA:FALSE' 'keyUsage=critical,digitalSignature,keyEncipherment' \
      'extendedKeyUsage=serverAuth' "subjectAltName=DNS:$HOST" > "$ext"
    [[ ! -f $crt ]] || cp "$crt" "$crt.bak-$(date +%Y%m%d%H%M%S)"
    ( umask 077
      openssl req -new -key "$key" -subj "/CN=$HOST" \
        | openssl x509 -req -CA "$TLS/ca.crt" -CAkey "$TLS/ca.key" -CAcreateserial -days 397 -sha256 \
            -extfile "$ext" -out "$crt.leaf" 2>/dev/null
      cat "$crt.leaf" "$TLS/ca.crt" > "$crt" && rm "$crt.leaf" )
    rm -f "$ext"
  fi
  # Chrome and Firefox-on-NSS read the user's NSS database.
  local cu nss="sql:$USER_HOME/.pki/nssdb"
  cu=$(certutil_bin)
  mkdir -p "$USER_HOME/.pki/nssdb"
  [[ -f "$USER_HOME/.pki/nssdb/cert9.db" ]] || "$cu" -N -d "$nss" --empty-password
  "$cu" -D -d "$nss" -n "$CA_NAME" >/dev/null 2>&1 || true
  "$cu" -A -d "$nss" -n "$CA_NAME" -t "C,," -i "$TLS/ca.crt"
  echo "ok: $CA_NAME is trusted by Chrome for this user (restart Chrome if it was open)."
  if ! hosts_ok || ! can_bind_443; then
    echo "next, once: sudo $0 root"
  fi
}

root_setup() {
  [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] || { echo "run: sudo $0 root" >&2; exit 1; }
  if ! grep -qE "^[[:space:]]*127\.0\.0\.1[[:space:]].*\b$HOST\b" /etc/hosts; then
    printf '127.0.0.1 %s  # optchat-local\n' "$HOST" >> /etc/hosts
    echo "added to /etc/hosts: 127.0.0.1 $HOST"
  fi
  setcap cap_net_bind_service=+ep "$CADDY"
  echo "caddy may bind :443 ($CADDY)"
  if [[ -f "$TLS/ca.crt" ]]; then
    # For the native app, curl and deno, which use the system store.
    if [[ -d /usr/local/share/ca-certificates ]]; then
      install -m 0644 "$TLS/ca.crt" /usr/local/share/ca-certificates/optchat-local-ca.crt && update-ca-certificates >/dev/null
    elif [[ -d /etc/pki/ca-trust/source/anchors ]]; then
      install -m 0644 "$TLS/ca.crt" /etc/pki/ca-trust/source/anchors/optchat-local-ca.crt && update-ca-trust
    fi
    echo "local CA added to the system store"
  fi
  echo "done. To undo: remove the '# optchat-local' line from /etc/hosts and run: sudo setcap -r $CADDY"
}

write_caddyfile() {
  local crt="$TLS/$HOST.crt" key="$TLS/$HOST.key" https=''
  if [[ -f $crt && -f $key ]]; then
    https+="https://$HOST:8443 {
    bind 127.0.0.1
    tls \"$crt\" \"$key\"
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Reframe-Router-Route $ROUTE
        header_up Host $HOST
    }
}
"
    if can_bind_443; then
      https+="
https://$HOST {
    bind 127.0.0.1
    tls \"$crt\" \"$key\"
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Reframe-Router-Route $ROUTE
        header_up Host $HOST
    }
}
"
    fi
  fi
  cat > "$CADDYFILE" <<CONFIG
# generated by optchat-local; edits are overwritten at every start
{
    admin off
    auto_https off
    servers {
        protocols h1 h2
    }
}

http://127.0.0.1:8080 {
    bind 127.0.0.1
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Reframe-Router-Route $ROUTE
    }
}

$https
CONFIG
}

stop_all() {
  local pids; pids=$(engine_pids)
  [[ -z "$pids" ]] && { echo "nothing running"; return; }
  kill -INT $pids 2>/dev/null || true
  for _ in $(seq 1 10); do
    pids=$(for p in $pids; do if kill -0 "$p" 2>/dev/null; then echo "$p"; fi; done)
    [[ -z "$pids" ]] && { echo "stopped"; return; }
    sleep 1
  done
  echo "force-killing: $pids"; kill -KILL $pids 2>/dev/null || true
}

status() {
  local p
  for p in 8000 8080 8443 443; do printf ':%-5s %s\n' "$p" "$(port_pids "$p" | tr '\n' ' ')"; done
  hosts_ok && echo "dns: $HOST -> 127.0.0.1" || echo "dns: $HOST is NOT local (sudo $0 root)"
  can_bind_443 && echo "caddy: may bind :443" || echo "caddy: may NOT bind :443 (sudo $0 root)"
  printf 'http://127.0.0.1:8080/engine/workspaces: '
  curl -s -m 5 "$ENGINE/engine/workspaces" || printf 'down'
  echo
  if [[ -f "$TLS/ca.crt" ]]; then
    printf 'https://%s/: ' "$HOST"
    curl -s -m 60 -o /dev/null -w '%{http_code}\n' --cacert "$TLS/ca.crt" --resolve "$HOST:443:127.0.0.1" "https://$HOST/" \
      || echo " (down)"
  fi
}

open_chrome() {
  local url="https://$HOST/"
  hosts_ok && can_bind_443 || url="$ENGINE/"
  [[ $url == https* ]] || echo "note: $HOST isn't set up yet (run: $0 setup; sudo $0 root); opening $url instead"
  if command -v google-chrome >/dev/null; then
    google-chrome "$url" >/dev/null 2>&1 &
  else
    xdg-open "$url" >/dev/null 2>&1 &
  fi
  echo "opened $url"
}

mode=${1:-web}
case "$mode" in
  stop) stop_all; exit 0 ;;
  logs) exec tail -F "$LOGS/hypervisor.log" "$LOGS/caddy.log" ;;
  status) status; exit 0 ;;
  setup) setup; exit 0 ;;
  root) root_setup; exit 0 ;;
  config) write_caddyfile; XDG_CONFIG_HOME="$L/caddy-config" XDG_DATA_HOME="$L/caddy-data" \
      "$CADDY" validate --config "$CADDYFILE" --adapter caddyfile 2>&1 | tail -1; cat "$CADDYFILE"; exit 0 ;;
  web|app|serve) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
[[ $EUID -ne 0 ]] || { echo "don't run the engine as root" >&2; exit 1; }

for f in "$RUNTIME" "$CADDY"; do
  [[ -x "$f" ]] || { echo "missing: $f" >&2; exit 1; }
done
[[ -f "$SRC/hub/@reframe/cli/main.ts" ]] || { echo "missing hypervisor source: $SRC (set REFRAME_HYPERVISOR_SRC)" >&2; exit 1; }
[[ $mode != app || -x "$APP" ]] || { echo "missing: $APP (install the OptChat package or set OPTCHAT_APP)" >&2; exit 1; }
[[ -x /usr/lib/chatgpt/resources/codex ]] || echo "warning: /usr/lib/chatgpt/resources/codex not found; Codex turns may fail" >&2

if [[ -n "$(engine_pids)" ]]; then
  echo "a local engine is already running (pid $(engine_pids | tr '\n' ' ')). Run: $0 stop" >&2
  exit 1
fi

mkdir -p "$LOGS"
write_caddyfile
hv_pid='' caddy_pid=''
cleanup() {
  trap - EXIT INT TERM
  echo "stopping local engine..."
  [[ -n "$hv_pid" ]] && kill -TERM "$hv_pid" 2>/dev/null || true
  [[ -n "$caddy_pid" ]] && kill -TERM "$caddy_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "starting hypervisor (log: $LOGS/hypervisor.log)"
(
  cd "$SRC"
  exec env PATH="$ENGINE_PATH" REFRAME_LOCAL=1 RUNTIME_SERVER_URL="${REFRAME_AETHER_URL:-https://reframe.so/~}" \
    "$RUNTIME" run -A --no-check --config="$SRC/deno.json" \
    "$SRC/hub/@reframe/cli/main.ts" hypervisor --listen=127.0.0.1:8000
) >"$LOGS/hypervisor.log" 2>&1 &
hv_pid=$!

echo "starting caddy (log: $LOGS/caddy.log)"
XDG_CONFIG_HOME="$L/caddy-config" XDG_DATA_HOME="$L/caddy-data" \
  "$CADDY" run --config "$CADDYFILE" --adapter caddyfile >"$LOGS/caddy.log" 2>&1 &
caddy_pid=$!

printf "waiting for engine"
ready=0
for ((i = 0; i < 180; i++)); do
  if ! kill -0 "$hv_pid" 2>/dev/null || ! kill -0 "$caddy_pid" 2>/dev/null; then
    echo; echo "a server exited during startup:" >&2
    tail -n 25 "$LOGS/hypervisor.log" "$LOGS/caddy.log" >&2
    exit 1
  fi
  [[ "$(curl -s -m 2 -o /dev/null -w '%{http_code}' "$ENGINE/" || true)" == 200 ]] && { ready=1; break; }
  printf "."; sleep 1
done
echo
[[ $ready == 1 ]] || { echo "engine did not come up in 3 min; see $LOGS/hypervisor.log" >&2; exit 1; }
echo "engine ready at $ENGINE"

case "$mode" in
  app)
    echo "opening OptChat (close the window or Ctrl-C to stop everything)"
    OPTCHAT_LOCAL_ENGINE="$ENGINE" "$APP" || true
    ;;
  web)
    open_chrome
    echo "Ctrl-C here stops the engine"
    wait -n "$hv_pid" "$caddy_pid" || true
    echo "a local server exited; see $LOGS" >&2
    ;;
  serve)
    echo "Ctrl-C here stops the engine"
    wait -n "$hv_pid" "$caddy_pid" || true
    echo "a local server exited; see $LOGS" >&2
    ;;
esac
